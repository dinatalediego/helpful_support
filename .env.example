# Copy to .env only when an integration needs credentials.
# Never commit .env. Python examples read environment variables directly.
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
USER_AGENT=helpful-support/0.2

# Public client values from Supabase Project Settings > API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional short-lived user JWT for remote-run. Never commit it.
SUPABASE_ACCESS_TOKEN=
